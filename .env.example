# ─── Django Core ─────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=change-me-50-random-chars-minimum-here
JWT_SECRET_KEY=change-me-different-50-random-chars-for-jwt

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=matedesk
POSTGRES_USER=matedesk
POSTGRES_PASSWORD=change-me-strong-db-password
DATABASE_URL=postgresql://matedesk:change-me-strong-db-password@postgres:5432/matedesk

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── pgAdmin (database browser) ───────────────────────────────────────────────
# Access at http://your-server:5050  (or via SSH tunnel locally)
PGADMIN_EMAIL=admin@matedesk.pro
PGADMIN_PASSWORD=change-me-strong-pgadmin-password

# ─── Django Hosts & CORS ──────────────────────────────────────────────────────
# Accepts requests for the apex domain and any subdomain
ALLOWED_HOSTS=matedesk.pro,app.matedesk.pro,.matedesk.pro

# Hostnames that are NOT tenant portals (apex + fixed subdomains)
# Requests to these are treated as the public marketing site
NON_TENANT_HOSTS=matedesk.pro,app.matedesk.pro

# CORS — in production, frontend and backend share the same domain via nginx,
# so same-origin requests never need CORS. Keep these for cross-origin clients
# (e.g. mobile app, Postman) if needed.
CORS_ALLOWED_ORIGINS=https://matedesk.pro,https://app.matedesk.pro
CORS_ALLOWED_ORIGIN_REGEXES=^https://[a-z0-9][a-z0-9-]*\.matedesk\.pro$

# CSRF — must list every domain that submits forms (POST/PUT/PATCH/DELETE)
CSRF_TRUSTED_ORIGINS=https://matedesk.pro,https://app.matedesk.pro,https://*.matedesk.pro

# ─── Gunicorn ─────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=3

# ─── Next.js (baked into Docker image at build time) ─────────────────────────
#
# NEXT_PUBLIC_API_URL — MUST be empty in production.
# Nginx routes /api/* to the backend on the same tenant subdomain, so
# same-origin requests preserve the tenant hostname automatically.
# Setting this to https://matedesk.pro would strip the tenant subdomain
# and break all tenant-scoped API calls.
NEXT_PUBLIC_API_URL=
#
# NEXT_PUBLIC_APP_DOMAIN — CRITICAL. Must match your apex domain exactly.
# If missing or wrong, Next.js middleware falls into dev mode and tenant
# subdomain enforcement is disabled for the entire application.
NEXT_PUBLIC_APP_DOMAIN=matedesk.pro
