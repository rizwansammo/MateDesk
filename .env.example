# ─── Django Core ─────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=change-me-50-random-chars-minimum-here
JWT_SECRET_KEY=change-me-different-50-random-chars-for-jwt

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=matedesk
POSTGRES_USER=matedesk
POSTGRES_PASSWORD=change-me-strong-db-password
DATABASE_URL=postgresql://matedesk:change-me-strong-db-password@postgres:5432/matedesk

# ─── Redis / Celery ──────────────────────────────────────────────────────────
# Container-internal hostnames — this stack runs its own isolated Redis, it does
# NOT share the host Redis on 127.0.0.1:6379 used by another app on the box.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
# Optional: defaults to CELERY_BROKER_URL when unset.
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── Django Hosts & CORS ──────────────────────────────────────────────────────
# Accepts requests for the apex domain and any subdomain
ALLOWED_HOSTS=matedesk.pro,.matedesk.pro

# Hostnames that are NOT tenant portals (apex + fixed subdomains)
# Requests to these are treated as the public marketing site
# www is 301d to the apex by nginx before Django sees it; listed here as a backstop.
NON_TENANT_HOSTS=matedesk.pro,www.matedesk.pro

# ─── Deployment topology ─────────────────────────────────────────────────────
# Existing MateDesk SaaS behaviour. Dedicated installs set single_tenant.
DEPLOYMENT_MODE=multi_tenant
# Required only for single_tenant deployments:
# SINGLE_TENANT_SLUG=netamate
# Defaults: enabled in multi_tenant, disabled in single_tenant.
# PUBLIC_REGISTRATION_ENABLED=True
# PLATFORM_ADMIN_ENABLED=True

# Optional public identity for dedicated deployments:
# PRODUCT_NAME=NetaMate HelpDesk
# PRODUCT_VENDOR_NAME=NetaMate Solutions
# LOGIN_HEADLINE=Welcome to NetaMate HelpDesk
# LOGIN_SUBTITLE=Sign in to manage and track your support requests.

# CORS — in production, frontend and backend share the same domain via nginx,
# so same-origin requests never need CORS. Keep these for cross-origin clients
# (e.g. mobile app, Postman) if needed.
CORS_ALLOWED_ORIGINS=https://matedesk.pro
CORS_ALLOWED_ORIGIN_REGEXES=^https://[a-z0-9][a-z0-9-]*\.matedesk\.pro$

# CSRF — must list every domain that submits forms (POST/PUT/PATCH/DELETE)
CSRF_TRUSTED_ORIGINS=https://matedesk.pro,https://*.matedesk.pro

# ─── Gunicorn ─────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=3

# ─── Next.js (baked into Docker image at build time) ─────────────────────────
#
# NEXT_PUBLIC_API_URL — MUST be empty in production.
# Nginx routes /api/* to the backend on the same tenant subdomain, so
# same-origin requests preserve the tenant hostname automatically.
# Setting this to https://matedesk.pro would strip the tenant subdomain
# and break all tenant-scoped API calls.
NEXT_PUBLIC_API_URL=
#
# NEXT_PUBLIC_APP_DOMAIN — CRITICAL. Must match your apex domain exactly.
# If missing or wrong, Next.js middleware falls into dev mode and tenant
# subdomain enforcement is disabled for the entire application.
NEXT_PUBLIC_APP_DOMAIN=matedesk.pro

# ─── Host ports (loopback only; nginx on the host proxies to these) ──────────
# Free on MateServer as of deploy. In use there already: 8001 NetaMate,
# 4000 TalkRoom, 5432/6379 host Postgres/Redis, 80/443 nginx.
BACKEND_PORT=8005
FRONTEND_PORT=3005

# ─── Image pinning (set by CI on each deploy) ────────────────────────────────
# CI exports these as ghcr.io/rizwansammo/matedesk-{backend,frontend}:<sha>.
# To roll back, set them to a previous SHA and `docker compose up -d`.
# MATEDESK_BACKEND_IMAGE=ghcr.io/rizwansammo/matedesk-backend:latest
# MATEDESK_FRONTEND_IMAGE=ghcr.io/rizwansammo/matedesk-frontend:latest

# MateMail Connected Apps API
MATEMAIL_BASE_URL=https://portal.matemail.online
