# Copy this file to .env and fill in your values.
# Never commit .env to version control.

DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key-in-production

# Database
DATABASE_URL=postgresql://matedesk_user:password@localhost:5432/matedesk_pro
# Fallback: leave blank to use SQLite during initial dev
# DATABASE_URL=

# Allowed hosts (comma-separated)
# Development:
ALLOWED_HOSTS=localhost,127.0.0.1
# Production — include root domain + wildcard subdomain:
# ALLOWED_HOSTS=matedesk.pro,www.matedesk.pro,*.matedesk.pro

# Non-tenant hosts — hostnames that bypass subdomain tenant resolution.
# CRITICAL: root domain and any service hostnames must be listed here so the
# TenantMiddleware does not attempt to resolve them as tenant subdomains.
# Development:
NON_TENANT_HOSTS=localhost,127.0.0.1
# Production:
# NON_TENANT_HOSTS=matedesk.pro,www.matedesk.pro,app.matedesk.pro,localhost,127.0.0.1

# CORS — frontend dev server
# Development:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production: tenant subdomains handle CORS via CORS_ALLOWED_ORIGIN_REGEXES in settings.py
# Do NOT add https://matedesk.pro as a CORS origin for tenant-scoped APIs.

# JWT secret (separate from Django SECRET_KEY for isolation)
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret

# Email (Phase 10)
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
