# ─── MateDesk — Frontend Environment Variables ───────────────────────────────
# Copy this file to .env.local for local development.
# NEVER commit .env.local to version control.
#
# NEXT_PUBLIC_* variables are baked into the Next.js bundle at build time.
# Changing them requires a full rebuild + redeploy.

# ─── API Base URL ─────────────────────────────────────────────────────────────
# Leave EMPTY in production. Nginx routes /api/* to the backend on the same
# origin, so the tenant subdomain is preserved automatically:
#   netamate.matedesk.pro/api/*  →  backend
#
# WARNING: Do NOT set this to https://matedesk.pro in production.
# That would strip the tenant subdomain from all API requests and break
# tenant isolation. Always keep it empty for production.
#
# For local development, point to the Django dev server:
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── App Domain ───────────────────────────────────────────────────────────────
# CRITICAL FOR PRODUCTION: Must be set to your apex domain.
#
# If this is missing or set to "localhost", Next.js middleware enters dev mode:
#   - Subdomain-based tenant enforcement is DISABLED
#   - All traffic is treated as same-host (no subdomain extraction)
#   - Tenant cookie is used for routing instead of the URL hostname
#
# Production:
NEXT_PUBLIC_APP_DOMAIN=matedesk.pro

# Deployment topology must match the backend. Existing SaaS stays multi_tenant.
NEXT_PUBLIC_DEPLOYMENT_MODE=multi_tenant
NEXT_PUBLIC_PRODUCT_NAME=MateDesk
NEXT_PUBLIC_PRODUCT_WORDMARK=MateDesk
NEXT_PUBLIC_PRODUCT_LOGO_VARIANT=
# Dedicated deployment example:
# NEXT_PUBLIC_APP_DOMAIN=helpdesk.netamate.com
# NEXT_PUBLIC_DEPLOYMENT_MODE=single_tenant
#
# Local development (comment out the production line above and use this):
# NEXT_PUBLIC_APP_DOMAIN=localhost
